# LangChain model provider IDs
LLM_CHAT_MODEL_NAME=google_genai:gemini-2.5-flash
LLM_STUDY_MODEL_NAME=google_genai:gemini-2.5-flash
LLM_TEMPERATURE=0.2
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Browser LLM selections: generate a Fernet key; do not commit it.
# Required to save credentials (including key-free Ollama selections).
LLM_KEY_ENCRYPTION_KEY=
LLM_SESSION_TTL_SECONDS=43200

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L12-v2
EMBEDDING_NORMALIZE=true

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=zerodha-varsity
RAG_TOP_K=5

# Ingestion
CHUNK_SIZE=600
CHUNK_OVERLAP=75

# PostgreSQL schema/migrations (not yet used by graph/API execution)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/financial_study

# Redis chat memory, study progress, and quiz cache
REDIS_URL=redis://localhost:6379

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=financial-study

# Declared settings; quiz code currently uses its own defaults/constants
QUIZ_DEFAULT_COUNT=10
QUIZ_CACHE_TTL=3600
