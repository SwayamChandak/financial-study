OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama — local LLM provider (kept for reference — switch by uncommenting)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma2

# Gemini — Google LLM provider (used by default)
GEMINI_API_KEY=your-gemini-api-key-here 
GEMINI_MODEL=gemini-3.5-flash

# Embedding model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L12-v2

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=zerodha-varsity
RAG_TOP_K=5

# Ingestion
CHUNK_SIZE=600
CHUNK_OVERLAP=75

# Telegram bot (optional — for scheduled delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Scheduler
SCHEDULER_CRON=0 8 * * *
SCHEDULER_TIMEZONE=Asia/Kolkata

# Redis — persistent progress memory
REDIS_URL=redis://localhost:6379

# LangSmith — tracing & observability (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devraj-pant

# Graph
GRAPH_RECURSION_LIMIT=25

# Financial data provider keys
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
